# Copy values into your process environment. The runtime never reads or writes
# a .env file and never persists API keys.
PAL_AGENT_PROVIDER=ollama
PAL_AGENT_MODEL=qwen3:8b
PAL_AGENT_TIMEOUT_SECONDS=90

PAL_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set to 1 only when you intentionally operate a trusted remote Ollama server.
PAL_AGENT_ALLOW_REMOTE_OLLAMA=0

# OpenAI-compatible mode (OpenAI, a compatible gateway, or a local server):
# PAL_AGENT_PROVIDER=openai-compatible
# PAL_AGENT_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# PAL_AGENT_OPENAI_API_KEY=

