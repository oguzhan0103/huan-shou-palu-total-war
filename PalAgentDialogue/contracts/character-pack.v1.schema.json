{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pal-agent-dialogue/character-pack.v1.schema.json",
  "title": "PalAgentDialogue Character Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "version", "contentLicense", "characters"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packId": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "contentLicense": { "type": "string", "minLength": 1, "maxLength": 128 },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/character" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choiceId", "textKey"],
      "properties": {
        "choiceId": { "$ref": "#/$defs/id" },
        "textKey": { "$ref": "#/$defs/key" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterId", "displayNameKey", "personaKey", "contentOrigin"],
      "properties": {
        "characterId": { "$ref": "#/$defs/id" },
        "displayNameKey": { "$ref": "#/$defs/key" },
        "personaKey": { "$ref": "#/$defs/key" },
        "contentOrigin": {
          "enum": ["localization_keys_only", "user_authored"]
        },
        "personaText": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "knowledgeKeys": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        },
        "allowedResultTags": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        },
        "defaultChoices": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/choice" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "contentOrigin": { "const": "localization_keys_only" } },
            "required": ["contentOrigin"]
          },
          "then": { "not": { "required": ["personaText"] } }
        },
        {
          "if": {
            "properties": { "contentOrigin": { "const": "user_authored" } },
            "required": ["contentOrigin"]
          },
          "then": { "required": ["personaText"] }
        }
      ]
    }
  }
}

