    "runtimeAndContentModuleContext": "implemented-offline-verified",
    "nativeExistingBossBinding": "five-current-pak-asset-candidates-confirmed-live-binding-pending",
    "replacementBossSlotBinding": "not-required-for-confirmed-five-unresolved-species-fails-closed",
    "nativePresentation": "contract-ready-real-provider-pending",
    "nativeCallbacks": "contract-ready-real-provider-pending",
    "liveAcceptance": "not-run"
  }
