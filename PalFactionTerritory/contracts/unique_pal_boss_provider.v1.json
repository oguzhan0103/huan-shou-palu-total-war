    "spawnDeliveryConfirmsRequestAcceptedOnly": true,
    "spawnCallbackRequiredBeforeCoreOpen": true,
    "failedDeliveriesRemainRetryable": true,
    "staleOpeningDeliveriesAreCancelled": true
