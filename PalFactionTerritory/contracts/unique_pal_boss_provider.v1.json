      "spawn",
      "defeat",
      "capture",
      "timeout"
    ],
    "exactChecks": [
      "providerId",
      "authoritySource",
      "bindingId",
      "uniquePalId",
      "openingEventId",
      "speciesId",
      "bossSpawnerKey",
      "actorBindingId",
      "actorClassKey",
      "worldGeneration"
    ],
    "stableCallbackIdsRequired": true,
    "duplicateSameSignatureIsIdempotent": true,
    "duplicateChangedSignatureIsConflict": true,
    "lateGenerationRejected": true
  },
  "defeatPolicy": {
    "closesCurrentOpening": true,
    "ownerRemainsWildOrUnclaimed": true,
    "automaticPlayerOwnership": false,
    "automaticNpcOwnership": false,
    "nativeCleanupAndCooldownDeliveryRequired": true,
    "nextScheduleRequired": true
  },
  "persistencePolicy": {
    "serializableProviderDefinitions": true,
    "deliveryLedger": true,
    "callbackSignatureLedger": true,
    "worldGeneration": true,
    "UObjectReferences": false,
    "PalworldSaveMutation": false
