    "directAssetDeletion": false,
    "reversibleSpawnerConfigurationOnly": true
  },
  "bindingPolicy": {
    "contentPackBindingStatusMustBe": "bound",
    "requiredVerifiedFields": [
      "speciesId",
      "bossSpawnerKey",
      "expectedActorClassKey",
      "PalworldBuildId"
    ],
    "routes": {
      "native-existing": {
        "nativeBossAvailable": true,
        "slotMustMatchContentDefinitionWhenPresent": true
      },
      "replacement-slot": {
        "nativeBossAvailable": false,
        "verifiedSlotIdRequired": true,
        "slotMustMatchContentDefinition": true
      }
    },
    "unknownSpeciesActorOrSlotFailsClosed": true
  },
  "raidSlabBalancePolicy": {
    "profileId": "raid-slab",
    "configurableFields": [
      "level",
      "healthMultiplier",
      "damageMultiplier",
      "damageReductionMultiplier",
      "statusResistanceMultiplier",
      "captureDifficultyMultiplier"
    ],
    "allNumericValuesMustBePositive": true,
    "captureAllowedMustRemainTrue": true,
    "coreDefaultNumbersProvided": false
  },
  "nativeDeliveryPolicy": {
