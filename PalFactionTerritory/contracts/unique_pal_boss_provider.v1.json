{
  "schemaVersion": "1.0.0",
  "apiVersion": "1.0.0",
  "providerApi": "PWFT_UNIQUE_PAL_BOSS_PROVIDER_BUS_V1",
  "contentStatus": "provider_ready_verified_native_bindings_required",
  "storyContentIncluded": false,
  "providerPolicy": {
    "configuredTrustedContentModuleActivationOnly": true,
    "idempotentDeliveryIdsRequired": true,
